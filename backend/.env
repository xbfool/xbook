# Database
DATABASE_URL=postgresql://xbook_admin:xbook_dev_password@localhost:5432/xbook

# Redis
REDIS_URL=redis://:xbook_redis_password@localhost:6379/0

# JWT Authentication
SECRET_KEY=your-secret-key-here-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API
API_V1_STR=/api/v1
PROJECT_NAME=XBook

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Environment
ENVIRONMENT=development

# Translation APIs (optional)
# DEEPL_API_KEY=your-deepl-api-key
# GOOGLE_TRANSLATE_API_KEY=your-google-api-key

# File Upload
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
ALLOWED_EXTENSIONS=pdf,epub,txt,mp3,wav,m4a

# Logging
LOG_LEVEL=INFO
